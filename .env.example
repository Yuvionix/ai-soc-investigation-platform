# ─────────────────────────────────────────────────────────────────
# SOC Real-Time SIEM Dashboard — Environment Variables
# Copy this file to .env and fill in your values before running.
# ─────────────────────────────────────────────────────────────────

# Application
APP_NAME="SOC Real-Time SIEM Dashboard"
DEBUG=False                          # Set True for development (enables hot-reload logs)
ENVIRONMENT=production               # development | production

# API Server
API_HOST=0.0.0.0                     # Use 127.0.0.1 to restrict to localhost only
API_PORT=8000

# Database (SQLite — file path relative to backend/)
DATABASE_URL=sqlite:///./data/soc_database.db

# SECURITY — CHANGE THESE BEFORE DEPLOYMENT
SECRET_KEY=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Auth
ENABLE_ENCRYPTION=True
ENABLE_INTEGRITY_CHECK=True

# Logging
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log                # Rotating file log (10MB x 5 files)

# CORS — add your frontend URL here
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000
